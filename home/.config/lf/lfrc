set preview true
set previewer ~/.config/lf/scope
set ratios 1:3
set drawbox false
set showbinds true
set hidden false
set info size:time
set dircounts false

set promptfmt "h/l parent/open  j/k move  gg/G ends  /? search  n/N repeat  space/V select  y/d/p copy/cut/paste  r rename  . hidden  DEL trash  D delete  e edit  : cmd  q quit  F2 keys %S%w"

cmd editselected ${{
    set -f
    IFS='
'
    vim -- $fx
}}

cmd open &{{
    case $(file --mime-type -Lb -- "$f") in
        text/*|application/json|application/xml|application/x-shellscript|inode/x-empty)
            lf -remote "send $id editselected"
            ;;
        image/*)
            swayimg "$f" >/dev/null 2>&1 &
            ;;
        application/pdf)
            zathura "$f" >/dev/null 2>&1 &
            ;;
        *)
            "$OPENER" "$f" >/dev/null 2>&1 &
            ;;
    esac
}}

cmd trash ${{
    mkdir -p "$HOME/.trash" || exit 1
    # lf separates selections with newlines; preserve tabs and literal globs.
    set -f
    IFS='
'

    for src in $fx; do
        base=${src##*/}
        dst="$HOME/.trash/$base"

        if [ -e "$dst" ] || [ -L "$dst" ]; then
            n=1
            while [ -e "$dst.$n" ] || [ -L "$dst.$n" ]; do
                n=$((n + 1))
            done
            dst="$dst.$n"
        fi

        mv -nT -- "$src" "$dst"
    done
}}

cmd delete ${{
    set -f
    IFS='
'
    printf '%s\n' $fx
    printf 'delete permanently? [y/N] '
    read -r ans </dev/tty
    [ "$ans" = "y" ] && rm -rf -- $fx
}}

