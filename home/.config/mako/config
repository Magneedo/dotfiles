anchor=bottom-right
background-color=#005577
text-color=#eeeeee
border-color=#005577
progress-color=over #444444
outer-margin=0,0,10,0
# Every card is 42 characters of this font wide (11 px each, plus padding and
# border): a history title line with its time, or the calendar's 7 columns.
# Heights grow with the content.
font=Noto Sans Mono 14
width=476
height=1100

[urgency=low]
default-timeout=10000

[urgency=critical]
border-color=#ff0000

[app-name=calendar]
default-timeout=20000
on-button-left=dismiss

[app-name=history]
default-timeout=20000
on-button-left=dismiss

# Agent pop-ups (agent-notify) are a one-line title: size each card to it,
# 11 px per character plus the 5 px padding and 2 px border on each side.

