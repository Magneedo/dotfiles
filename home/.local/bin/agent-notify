#!/bin/sh
set -eu

# Claude and Codex hook with the agent's name as $1: PermissionRequest
# (Claude only: it fires when a dialog is shown, but Codex's fires before
# automatic review), PreToolUse for Codex's question tools, and Stop. Shows
# "Agent: reason" and logs it, with a summary, to the Vault's notification
# history (bar-panel history shows it). An agent may end a reply with
# "Notify: summary" or "Notify: high|medium|approval|review | summary" to set
# the summary and a label; a question starting "Approval:" is one. "review"
# means the other agent is still reviewing the work.
jq -r --arg agent "$1" '
    def oneline: .[:1000] | gsub("[\\s\\x1f]+"; " ") | .[:160];
    ((.cwd // "") | split("/") | last // "" | oneline | gsub("[()]"; "")) as $dir |
    def question:
        [.tool_input.questions[]? | .title // .question // "" |
         select(test("\\S"))] as $q |
        if ($q | length) == 0 then empty
        elif any($q[]; test("^\\s*Approval:"; "i")) then
            ["", "critical", "Needs approval", $dir, ($q | join(" ") | oneline)]
        else ["", "normal", "Has a question", $dir, ($q | join(" ") | oneline)] end;
    if .hook_event_name == "PermissionRequest" then
        if .tool_name == "AskUserQuestion" then question
        else
            (.tool_input.command // .tool_input.description //
                .tool_input.file_path // "" | tostring | oneline) as $x |
            ["", "critical", "Needs approval", $dir,
             (.tool_name + if $x != "" then ": " + $x else "" end)]
        end
    elif .hook_event_name == "PreToolUse" then
        if (.tool_name | test("^request_user_input(_async)?$")) then question
        else empty end
    elif .hook_event_name != "Stop" then
        empty
    else
        (.last_assistant_message // "" | split("\n") |
         map(select(test("\\S")))) as $lines |
        ($lines | last // "" | capture("^\\s*Notify:\\s*" +
            "((?<l>high|medium|low|approval|review)\\s*\\|)?\\s*(?<t>.*)"; "i")
         // {l: null, t: ""}) as $n |
        ($n.l // "" | ascii_downcase) as $l |
        (if $l == "approval" then ["", "critical", "Needs approval"]
         elif $l == "high" then ["High", "critical", "Needs you"]
         elif $l == "medium" then ["Medium", "normal", "Has a question"]
         elif $l == "review" then ["", "low", "In review by " +
             if $agent == "Codex" then "Claude" else "Codex" end]
         elif $l == "" and ($lines | last // "" | test("\\?\\s*$"))
         then ["", "normal", "Has a question"]
         else ["", "low", "Finished"] end) +
        [$dir,
         (if $n.t != "" then $n.t else $lines[0] // "" end | oneline)]
    end | map(tostring) | join("\u001f")' |
{
    IFS=$(printf '\037') read -r level urgency reason dir detail || exit 0
    title="$1: $reason"
    [ -z "$level" ] || title="[$level] $title"
    # Agents read hook stdout, so keep it empty.
    notify-send -a agent -u "$urgency" "$title" >/dev/null
    printf -- '- %s **%s** (%s) %s\n' "$(date +'%F %-I:%M %p')" "$title" "$dir" \
        "$detail" >>"$HOME/Vault/Agents/Notifications.md"
}
