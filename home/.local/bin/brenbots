#!/bin/sh
set -eu

# Claude runs in its own tmux server, started by the first Mod+c. Mod+c opens
# the popup or hides it if it is already open, leaving the agents running.
# Alt+Tab cycles through them, and Alt+1 and Alt+2 show Claude and Codex,
# starting it if needed; Codex, heavy on RAM, starts only that way. Closing the
# popup (Mod+q) stops them all.
tmux="tmux -L brenbots"
# As in dwl-session, so agents started over SSH keep their state here too.
export CLAUDE_CONFIG_DIR="$HOME/Vault/Agents/.claude"
export CODEX_HOME="$HOME/Vault/Agents/.codex"

# Over SSH (from the phone) there is no Wayland. Give the agents the laptop's
# session, if one is running, for pop-ups, the clipboard and the agent desk.
phone=
if [ -z "${WAYLAND_DISPLAY-}" ]; then
    phone=1
    session="${XDG_RUNTIME_DIR-}/dwl-session-env"
    [ ! -r "$session" ] || . "$session"
fi

# Start an agent in window $1 unless it is already running (it may have
# exited).
run() {
    name=$1
    shift
    $tmux list-windows -t brenbots -F '#W' 2>/dev/null | grep -qx "$name" && return
    if $tmux has-session -t brenbots 2>/dev/null; then
        $tmux new-window -d -t brenbots -n "$name" -c "$HOME/Vault/Agents" "$@"
    else
        # Without mouse mode, foot turns the wheel into arrow keys: prompt
        # history. No prefix key, so Ctrl+B still reaches Claude. The popup's
        # title, shown in the bar, names the agent on screen.
        $tmux set -g mouse on \; \
            set -g history-limit 50000 \; set -g prefix None \; \
            set -g set-titles on \; set -g set-titles-string '#W' \; \
            bind -n M-Tab next-window \; \
            new-session -d -s brenbots -n "$name" -c "$HOME/Vault/Agents" "$@"
    fi
}

if [ -z "$phone" ] &&
    [ -n "$($tmux list-clients -t brenbots 2>/dev/null)" ]; then
    exec $tmux detach-client -s brenbots
fi

# Claude's default fullscreen renderer takes the mouse wheel; the classic one
# leaves scrolling to tmux's copy mode (with its position indicator), as Codex
# does with --no-alt-screen. Background sessions are always fullscreen, so
# agent view, which runs them, is off too.
claude='env CLAUDE_CODE_NO_FLICKER=0 CLAUDE_CODE_DISABLE_AGENT_VIEW=1 claude'
# Codex exits if it can't reach its servers at start (no network yet at
# login), so retry until it starts; /quit exits 0 and ends the loop.
codex="sh -c 'until codex --no-alt-screen; do sleep 5; done'"
run claude "$claude"

# No status line: the bot's name flashes at the top left in dwl/dwlb's
# colours when the popup opens and on Alt+Tab, in a floating pane that takes
# no focus or keys and closes after 0.75 s (a message at the top would shift
# the pane down a row). Its border is drawn as blank cells, so it shows as a
# one-row box with a gap to its left, right and below (the size includes the
# border, whose top row is off screen). Copy mode shows the scroll position at
# the top right in the same colours, with a gap to its left and right. The
# outer gaps keep both boxes one cell from the popup's sides: foot leaves the
# width's remainder after its last whole cell on the right, which showed as a
# thin dark line between the count and the blue border. Both boxes are 13
# cells, which fits 50000/50000 (the history limit), with the text centred:
# right-aligned to (13 + its length) / 2 cells, then padded to 13. Apply on
# every start, including when the agents are already running.
flash='run -b -C "new-pane -d -x 15 -y 3 -X 0 -Y -1 '\
'-s fg=##eeeeee,bg=##005577 \"printf \\\"%*s\\\" '\
'#{e|/:#{e|+:13,#{n:window_name}},2} #W; sleep .75\""'
pos='#[align=right]#[bg=terminal] #[default]'\
'#{p13:#{p-#{e|/:#{e|+:13,#{n:#{copy_position}/#{copy_position_limit}}},2}:'\
'#{copy_position}/#{copy_position_limit}}}#[bg=terminal] '
dir=$HOME/Vault/Agents
$tmux bind -n M-1 new-window -S -n claude -c "$dir" "$claude" \; \
    bind -n M-2 new-window -S -n codex -c "$dir" "$codex" \; \
    set -g status off \; \
    set -gw pane-border-lines spaces \; \
    set-hook -g client-attached "$flash" \; \
    set-hook -g session-window-changed "$flash" \; \
    set -gw mode-style 'fg=#eeeeee,bg=#005577' \; \
    set -gw copy-mode-position-format "$pos"

# Over SSH (from the phone) there is no popup: attach a session of its own
# that shares the agents' windows, so Mod+c on the laptop never detaches it.
[ -z "$phone" ] || exec $tmux new-session -A -s phone -t brenbots

# Hiding detaches the client, which exits 0. Closing the window hangs it up,
# so it exits 1 and the shell, which ignores the hangup, stops the server.
exec footclient --app-id=brenbots \
    sh -c "trap '' HUP; $tmux attach -t brenbots || $tmux kill-server"
