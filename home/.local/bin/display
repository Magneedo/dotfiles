#!/bin/sh

OUT="DP-1"
MODE="2560x1440@143.972000"

# Do not use set -e here. The normal mode set is expected to fail
# when the dock exposes only fallback EDID modes.

LOG="/tmp/display.log"

log() {
  printf '%s\n' "$*" >> "$LOG"
}

: > "$LOG"

log "display: starting"
log "display: output=$OUT mode=$MODE"

if ! command -v wlr-randr >/dev/null 2>&1; then
  log "display: wlr-randr not found"
  exit 1
fi

sleep 3

i=0
while [ "$i" -lt 20 ]; do
  i=$((i + 1))

  log "display: attempt $i using listed mode"

  if wlr-randr --output "$OUT" --on --mode "$MODE" >> "$LOG" 2>&1; then
    log "display: success using listed mode"
    exit 0
  fi

  log "display: attempt $i using custom mode"

  if wlr-randr --output "$OUT" --on --custom-mode "$MODE" >> "$LOG" 2>&1; then
    log "display: success using custom mode"
    exit 0
  fi

  sleep 1
done

log "display: listed/custom mode failed, trying output reset"

i=0
while [ "$i" -lt 10 ]; do
  i=$((i + 1))

  log "display: reset attempt $i"

  wlr-randr --output "$OUT" --off >> "$LOG" 2>&1 || true
  sleep 1
  wlr-randr --output "$OUT" --on >> "$LOG" 2>&1 || true
  sleep 1

  if wlr-randr --output "$OUT" --on --custom-mode "$MODE" >> "$LOG" 2>&1; then
    log "display: success after reset using custom mode"
    exit 0
  fi

  sleep 1
done

log "display: failed"
exit 1
