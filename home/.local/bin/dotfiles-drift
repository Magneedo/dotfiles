#!/bin/sh
# List mirrored files in ~/Projects/dotfiles whose live copy differs or is missing.
# Exits 1 if any do. Files this user can't read are listed but don't count.
set -eu

cd "$HOME/Projects/dotfiles"
git ls-files -- home etc usr | {
    rc=0
    while IFS= read -r f; do
        case $f in
            home/*) live=$HOME/${f#home/} ;;
            *) live=/$f ;;
        esac
        if [ -r "$live" ]; then
            cmp -s "$f" "$live" && continue
            echo "differs    $live"
        elif [ -e "$live" ] || [ ! -x "${live%/*}" ]; then
            echo "unreadable $live"
            continue
        else
            echo "missing    $live"
        fi
        rc=1
    done
    exit "$rc"
}
