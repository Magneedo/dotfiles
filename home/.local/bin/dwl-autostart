#!/bin/sh
set -eu

uid="$(id -u)"
logdir="${XDG_RUNTIME_DIR:-/tmp}"

dbus-update-activation-environment \
    WAYLAND_DISPLAY \
    XDG_CURRENT_DESKTOP \
    XDG_SESSION_DESKTOP \
    XDG_SESSION_TYPE \
    XDG_RUNTIME_DIR \
    >/dev/null 2>&1 || true

command -v brightnessctl >/dev/null 2>&1 &&
    brightnessctl set 1% >/dev/null 2>&1 || true

if ! pgrep -u "$uid" -x pipewire >/dev/null 2>&1; then
    pipewire >"$logdir/pipewire.log" 2>&1 &
fi

i=0
while [ ! -S "$logdir/pipewire-0" ] && [ "$i" -lt 40 ]; do
    sleep 0.05
    i=$((i + 1))
done

if ! pgrep -u "$uid" -x wireplumber >/dev/null 2>&1; then
    wireplumber >"$logdir/wireplumber.log" 2>&1 &
fi

if ! pgrep -u "$uid" -x pipewire-pulse >/dev/null 2>&1; then
    pipewire-pulse >"$logdir/pipewire-pulse.log" 2>&1 &
fi

wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.50 >/dev/null 2>&1 || true
wpctl set-mute @DEFAULT_AUDIO_SINK@ 0 >/dev/null 2>&1 || true

# Linux process names are limited to 15 bytes; match portal command lines.
if ! pgrep -u "$uid" -f '^(/usr/lib/)?xdg-desktop-portal-wlr([[:space:]]|$)' >/dev/null 2>&1; then
    /usr/lib/xdg-desktop-portal-wlr \
        >"$logdir/xdg-desktop-portal-wlr.log" 2>&1 &
fi

if ! pgrep -u "$uid" -f '^(/usr/lib/)?xdg-desktop-portal([[:space:]]|$)' >/dev/null 2>&1; then
    /usr/lib/xdg-desktop-portal --replace \
        >"$logdir/xdg-desktop-portal.log" 2>&1 &
fi

foot --server >/dev/null 2>&1 &
"$HOME/.local/bin/wallpaper" >/dev/null 2>&1 &

(
    while ! pgrep -u "$uid" -x dwlb >/dev/null 2>&1; do
        sleep 0.05
    done

    "$HOME/.local/bin/statusd" |
        while IFS= read -r status; do
            dwlb -status all "$status"
        done
) >"$logdir/dwlb-status.log" 2>&1 &

exec dwlb
