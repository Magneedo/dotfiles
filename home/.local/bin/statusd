#!/bin/sh
set -eu

BACKLIGHT_DIR=""
for p in /sys/class/backlight/*; do
    if [ -r "$p/max_brightness" ]; then
        BACKLIGHT_DIR="$p"
        break
    fi
done

BAT_DIR=""
for p in /sys/class/power_supply/*; do
    [ -r "$p/type" ] || continue
    IFS= read -r type < "$p/type" || type=""
    if [ "$type" = "Battery" ]; then
        BAT_DIR="$p"
        break
    fi
done

bat_str() {
    if [ -n "$BAT_DIR" ] && [ -r "$BAT_DIR/capacity" ]; then
        IFS= read -r capacity < "$BAT_DIR/capacity" || capacity="n/a"
        printf '%s%%' "$capacity"
    else
        printf 'n/a'
    fi
}

bright_str() {
    [ -n "$BACKLIGHT_DIR" ] || {
        printf 'n/a'
        return
    }

    IFS= read -r max < "$BACKLIGHT_DIR/max_brightness" || max=0

    if [ -r "$BACKLIGHT_DIR/actual_brightness" ]; then
        IFS= read -r cur < "$BACKLIGHT_DIR/actual_brightness" || cur=0
    else
        IFS= read -r cur < "$BACKLIGHT_DIR/brightness" || cur=0
    fi

    if [ "$max" -gt 0 ] 2>/dev/null; then
        printf '%d%%' "$((cur * 100 / max))"
    else
        printf '0%%'
    fi
}

vol_str() {
    command -v wpctl >/dev/null 2>&1 || {
        printf 'n/a'
        return
    }

    out="$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null)" || {
        printf 'n/a'
        return
    }

    case "$out" in
        *"[MUTED]"*)
            printf 'mu'
            return
            ;;
    esac

    set -- $out
    v="${2:-}"

    [ -n "$v" ] || {
        printf 'n/a'
        return
    }

    awk -v x="$v" 'BEGIN { printf "%d%%", x * 100 + 0.5 }'
}

airplane_mode() {
    have_all=0
    all_soft=0
    wlan_soft=0
    bt_soft=0

    for path in /sys/class/rfkill/*; do
        [ -d "$path" ] || continue
        [ -r "$path/type" ] || continue
        [ -r "$path/soft" ] || continue

        IFS= read -r type < "$path/type" || continue
        IFS= read -r soft < "$path/soft" || soft=0

        case "$type" in
            all)
                have_all=1
                [ "$soft" = 1 ] && all_soft=1
                ;;
            wlan)
                [ "$soft" = 1 ] && wlan_soft=1
                ;;
            bluetooth)
                [ "$soft" = 1 ] && bt_soft=1
                ;;
        esac
    done

    [ "$have_all" -eq 1 ] && [ "$all_soft" -eq 1 ] && return 0
    [ "$wlan_soft" -eq 1 ] && [ "$bt_soft" -eq 1 ] && return 0

    return 1
}

default_iface() {
    ip -o route show default 2>/dev/null |
        awk '
        {
            dev = ""
            metric = 0

            for (i = 1; i <= NF; i++) {
                if ($i == "dev")
                    dev = $(i + 1)
                else if ($i == "metric")
                    metric = $(i + 1)
            }

            if (dev != "" && (!found || metric < best)) {
                best = metric
                iface = dev
                found = 1
            }
        }

        END {
            if (found)
                print iface
        }'
}

net_str() {
    if airplane_mode; then
        printf '✈'
        return
    fi

    iface="$(default_iface)" || iface=""

    [ -n "$iface" ] || {
        printf 'off'
        return
    }

    case "$iface" in
        eth*|en*|enx*)
            printf 'eth'
            ;;
        wl*|wlan*)
            printf 'wifi'
            ;;
        *)
            printf '%s' "$iface"
            ;;
    esac
}

bat="n/a"
bri="n/a"
vol="n/a"
net="off"

tick=0

while :; do
    vol="$(vol_str)"
    bat="$(bat_str)"
    bri="$(bright_str)"

    if [ "$tick" -eq 0 ] || [ "$tick" -ge 5 ]; then
        # dwlb reads ^ as the start of a command; ^^ prints a literal ^.
        net="$(net_str | sed 's/\^/^^/g')"
        tick=0
    fi

    printf '[ ^lm(tofi-power)^rm(tofi-power-profile)bat %s^rm()^lm() | ^lm(bluefilter menu)^us(brightnessctl -q set 1%%+)^ds(brightnessctl -q set 1%%-)bri %s^ds()^us()^lm() | ^lm(wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle)^rm(tofi-audio)^us(wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%%+)^ds(wpctl set-volume @DEFAULT_AUDIO_SINK@ 1%%-)vol %s^ds()^us()^rm()^lm() | ^lm(tofi-net)net %s^lm() | ^lm(bar-panel calendar)^rm(bar-panel history)%s^rm()^lm() ]\n' \
        "$bat" \
        "$bri" \
        "$vol" \
        "$net" \
        "$(date '+%b %-d, %-I:%M %p')"

    tick=$((tick + 1))
    sleep 1
done
