#!/usr/bin/env bash
set -euo pipefail

WALLPAPER="$HOME/Pictures/Screensaver/Screensaver"

XDG="${XDG_RUNTIME_DIR:-/tmp}"
DISP="${WAYLAND_DISPLAY:-wayland-0}"
SOCK="$XDG/$DISP"

while [ ! -S "$SOCK" ]; do
    sleep 0.1
done

exec 9>"$XDG/wallbgd.lock"
flock -n 9 || exit 0

exec swaybg -i "$WALLPAPER" -m fill
